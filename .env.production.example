PUBLIC_HOST=example.com
ACME_EMAIL=admin@example.com

APP_PORT=3000
GRAFANA_PORT=3001

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_SECONDS=3600

POSTGRES_DB=iut_ict_fest
POSTGRES_USER=iut_ict_fest
POSTGRES_PASSWORD=replace-with-a-long-random-db-password

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_AUTH_SUCCESS_URL=

# Keep these private on a VPS. They are internal Docker ports unless exposed
# through docker-compose.yml directly.
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_PROM_EXPORTER_PORT=8889

PROMETHEUS_DS_URL=http://prometheus:9090
LOKI_DS_URL=http://loki:3100
TEMPO_DS_URL=http://tempo:3200
