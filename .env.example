# BDApps credentials — copy this file to ".env" and fill in the real values.
# Get these from https://user.bdapps.com -> Provisioning -> your app.

BDAPPS_APP_ID=APP_000000
BDAPPS_PASSWORD=your_32_character_api_key_here
BDAPPS_APP_NAME=HackApp

# Optional — defaults to the production URL if omitted.
BDAPPS_BASE_URL=https://developer.bdapps.com

# Server port (used by src/server.ts)
PORT=3000
